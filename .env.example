# Copy this file to .env and edit. .env is gitignored.

# --- Auth ---
# static = original shared token; hybrid = OIDC + emergency token; oidc = OIDC only.
AUTH_MODE=static
# Generate the static/hybrid emergency token with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=replace-me-with-a-strong-token

# Provider-neutral OpenID Connect settings. Required only for hybrid/oidc.
# Cognito issuer example:
# https://cognito-idp.us-east-1.amazonaws.com/us-east-1_Example
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Browser authorization request scopes. Cognito works with these defaults.
OIDC_BROWSER_SCOPES=openid profile email
# Optional API scopes, space-separated. Leave blank until a Cognito resource
# server/custom scope exists; when set, every OIDC access token must include all.
OIDC_REQUIRED_SCOPES=
# Discovery metadata and signing keys are cached, then refreshed on an unknown kid.
OIDC_JWKS_CACHE_SECONDS=3600

# --- Model selection ---
# Whisper model size. Options: tiny, base, small, medium, large-v2, large-v3.
# medium is the default for the current 7.7 GiB VM (B-001). Bump to large-v3
# once the VM has >= 16 GiB RAM allocated.
WHISPER_MODEL=medium

# CTranslate2 compute type. int8 is the right default for CPU.
# Options on CPU: int8, int16, float32. (float16 / int8_float16 are GPU-only.)
WHISPERX_COMPUTE_TYPE=int8

# Inference device. cpu | cuda
WHISPERX_DEVICE=cpu

# Whisper language hint. Leave blank to auto-detect.
WHISPER_LANGUAGE=

# pyannote diarization model. Default is the community model (CC-BY-4.0), which
# requires attribution — see NOTICE.
#
# Both supported models are GATED on HuggingFace, so HF_TOKEN is required either
# way:
#   community-1 -> accept its conditions (sharing contact information) at
#                  https://huggingface.co/pyannote/speaker-diarization-community-1
#   3.1         -> accept conditions for BOTH
#                  https://huggingface.co/pyannote/speaker-diarization-3.1 and
#                  https://huggingface.co/pyannote/segmentation-3.0
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# HuggingFace token, from https://huggingface.co/settings/tokens, under an
# account that has accepted the conditions for DIARIZATION_MODEL above.
# Required for both supported diarization models. Without it the model download
# fails at startup with a 401/403 from HuggingFace.
HF_TOKEN=

# --- Diarization backend (docker-compose.gpu.yml) ---
# 'local'  — in-process pyannote on CPU (default; Phase 2/3 behavior).
# 'remote' — offload to the GPU diarize-svc sidecar (Blackwell-capable CUDA
#            torch + pyannote), which is the pipeline's biggest speed win.
#            Falls back to in-process CPU pyannote per-request if the sidecar is
#            unreachable, so a GPU/sidecar outage never fails a job.
# The GPU compose sets these for transcribe-svc automatically; override here only
# to force CPU-only diarization (DIARIZE_BACKEND=local).
DIARIZE_BACKEND=local
DIARIZE_URL=
DIARIZE_HEALTHCHECK_TIMEOUT_S=3.0

# --- Concurrency / retention ---
# Hard cap on concurrent transcription jobs. Default 1 for the 7.7 GiB VM (B-001);
# raise to 2 after VM RAM is increased.
MAX_CONCURRENT_JOBS=1

# Days to retain uploads + outputs. Cleanup runs on container start.
# RETAIN_DAYS=0 deletes anything older than the moment of restart.
# Set negative (e.g. -1) to disable cleanup entirely.
# models_dir is never swept regardless of this value.
RETAIN_DAYS=30

# --- Storage paths (inside the container; backed by named volumes) ---
DATA_DIR=/data
# HF_HOME is where HuggingFace caches downloaded models.
HF_HOME=/data/models/hf

# --- Server ---
# Bind address inside the container.
APP_HOST=0.0.0.0
APP_PORT=8000

# Max upload size in MB (per spec §4: <= 500 MB).
MAX_UPLOAD_MB=500

# --- Phase 3: ASR routing ---
# 'whisperx' — in-container WhisperX only (Phase 2 default; use on CPU host).
# 'router'   — try backends in ASR_HOSTS order; sentinel 'local-whisperx'
#              means fall back to in-container WhisperX.
ASR_BACKEND=whisperx

# Comma-separated priority list of OpenAI-compat backends (Speaches on
# Alienware, whisper.cpp server on Mac) plus the local-whisperx sentinel.
# Only consumed when ASR_BACKEND=router.
# Example:
#   ASR_HOSTS=http://localhost:8001,http://mbp.tailnet.ts.net:8001,local-whisperx
ASR_HOSTS=

# HuggingFace model ID passed to OpenAI-compat backends. Ignored for
# local-whisperx (which uses WHISPER_MODEL).
ASR_MODEL_ID=Systran/faster-whisper-large-v3

# Health-check timeout per backend (seconds).
ASR_HEALTHCHECK_TIMEOUT_S=2.0

# --- Track B: speaker role labels (voice enrollment) ---
# Off by default. When 1/true, the pipeline embeds each diarized speaker cluster
# after stitching, cosine-matches it against enrolled voiceprints, and relabels
# matches (e.g. 'Therapist'); in a 2-speaker session the other becomes 'Client'.
# When 0/false the /v1 output is unchanged (anonymous SPEAKER_00/01).
ENABLE_ROLE_LABELS=0

# Directory of enrolled *.npy voiceprints, built offline by `ml/enroll`. These
# are BIOMETRIC data — keep them off the repo and off shared/cloud storage. Back
# by a private volume. Built with:
#   docker compose -f docker-compose.gpu.yml run --rm -v ${PWD}/ml:/app/ml \
#     transcribe-svc python -m ml.enroll.enroll --name Therapist --clip ref.wav
ENROLLMENTS_DIR=/data/enrollments

# Pretrained speaker-embedding model. Default is pyannote's wespeaker, already
# cached by the diarizer (no extra download / dependency). Needs HF_TOKEN if the
# model is gated (accept its conditions on HuggingFace).
EMBEDDING_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM

# Minimum cosine similarity to accept an enrollment match. Operating point comes
# from ml/enroll/sweep.py (see ml/enroll/reports/). Re-sweep on real voices.
ROLE_MATCH_THRESHOLD=0.5

# Label applied to the non-enrolled speaker in a 2-speaker session.
CLIENT_LABEL=Client

# --- Tailscale sidecar (docker-compose.gpu.yml only) ---
# Reusable auth key with tag:transcribe-svc pre-approved. Generate at
# https://login.tailscale.com/admin/settings/keys — check "Reusable" and
# "Pre-approved" and add tag:transcribe-svc.
TS_AUTHKEY=

# --- Reserved / not yet wired in ---
# Held here so the operator can drop keys in while the codes are in front of
# them; the application currently ignores these. They will only become live
# when an explicit feature opts into them (e.g. a future transcript
# summarization pass via Claude). Do NOT route audio to OpenAI without a
# deliberate decision — that would conflict with the privacy goal in
# PROJECT_PLAN.md §1.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
